@* a CRT monitor made of three CSS 3D cuboids (bezel, tube housing, stand), no WebGL and no dependencies *@
<div class="crt" aria-hidden="true">
    <div class="rig">
        <div class="box bezel">
            <div class="f F">
                <div class="screen">
<pre>$ whoami
shira (she/they)
$ cat changelog
2023  google sites profile card
2023  same card, self-hosted
2026  blazor + one css file + crt
$ <span class="cur">█</span></pre>
                    <span class="osd"></span>
                    <div class="haj"><img src="@Assets["blahaj.png"]" alt="" width="96" height="96" /></div>
                </div>
                <span class="label">MAGISHIRA</span>
                <span class="led"></span>
            </div>
            @foreach (var s in "BLRTD") { <div class="f @s"></div> }
        </div>
        <div class="box rear">
            @foreach (var s in "FBLRTD") { <div class="f @s"></div> }
        </div>
        <div class="box stand">
            @foreach (var s in "FBLRTD") { <div class="f @s"></div> }
        </div>
    </div>
</div>

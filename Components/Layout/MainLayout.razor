@inherits LayoutComponentBase

<a class="skip" href="#main">Skip to content</a>
<header>
    <div class="wrap">
        <a class="brand" href="/">magishira.dev</a>
        <nav>
            <div class="links" id="menu">
                <NavLink href="/projects">Projects</NavLink>
                <NavLink href="/photos">Photos</NavLink>
                <NavLink href="/me">About</NavLink>
            </div>
            <button class="theme" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                <Icon Name="light_mode" Class="sun" />
                <Icon Name="dark_mode" Class="moon" />
            </button>
            <button class="menubtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu">
                <Icon Name="menu" Class="open" />
                <Icon Name="close" Class="shut" />
            </button>
        </nav>
    </div>
</header>

<main class="wrap" id="main">
    @Body
</main>

<footer>
    <div class="wrap">
        <span class="signoff">Made with <img src="@Assets["heart.png"]" alt="love" width="62" height="48" /> by Shira</span>
        <nav class="social" aria-label="Social links">
            <a href="https://github.com/MagiShira" title="GitHub" aria-label="GitHub"><Icon Name="github" /></a>
            <a href="https://linkedin.com/in/elane-faisal-sage" title="LinkedIn" aria-label="LinkedIn"><Icon Name="linkedin" /></a>
            <a href="https://discord.com/users/219501317532549120" title="Discord" aria-label="Discord"><Icon Name="discord" /></a>
            <a href="mailto:shira@magishira.dev" title="Email" aria-label="Email"><Icon Name="mail" /></a>
        </nav>
    </div>
</footer>

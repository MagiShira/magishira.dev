@page "/blog"

<PageMeta Title="Blog — magishira.dev" Description="Writing by Shira on endpoint management, homelabs, and whatever else is worth writing down." />

<div class="pagehead">
    <h1>Blog</h1>
    <div class="headtools">
        <a class="iconbtn" href="/blog/feed.xml" title="RSS feed" aria-label="RSS feed"><Icon Name="rss" /></a>
    </div>
</div>

@if (PostList.Visible.Any())
{
    <PostRows Posts="PostList.Visible" />
}
else
{
    <p class="mute">Nothing here yet.</p>
}

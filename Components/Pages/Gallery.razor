@page "/photos"

<PageMeta Title="Photos — magishira.dev" Description="Photos by Shira: graduation portraits, Lake Tahoe and the Nevada backcountry, hot air balloons over Reno, a cleanroom on the quad, a hackathon, and whatever else is around." />

<h1>Photos</h1>

<div class="gallery">
    @foreach (var ph in PhotoList.Items)
    {
        <figure id="@Path.GetFileNameWithoutExtension(ph.File)">
            <a href="@Assets[ph.File]"><img src="@Assets[ph.File]" alt="@ph.Alt" loading="lazy" width="@ph.Width" height="@ph.Height" /></a>
            <figcaption>@if (ph.Title.Length > 0) { <strong>@ph.Title</strong> } @ph.Caption</figcaption>
        </figure>
    }
</div>

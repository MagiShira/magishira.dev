@page "/photos"

<PageMeta Title="Photos — magishira.dev" Description="Photos by Shira: graduation portraits, Lake Tahoe and the Nevada backcountry, hot air balloons over Reno, a cleanroom on the quad, a hackathon, and whatever else is around." />

<div class="pagehead">
    <h1>Photos</h1>
    <Finder Noun="photos" Items=".gallery figure" Tags="PhotoList.AllTags" />
</div>

<div class="gallery">
    @foreach (var ph in Shuffled)
    {
        <figure id="@Path.GetFileNameWithoutExtension(ph.File)" data-tags="@TagAttr(ph)" data-text="@TextAttr(ph)">
            <a href="@Assets[ph.File]" data-title="@ph.Title" data-caption="@ph.Caption"><img src="@Assets[ph.File]" alt="@ph.Alt" loading="lazy" width="@ph.Width" height="@ph.Height" /></a>
            <figcaption>@if (ph.Title.Length > 0) { <strong>@ph.Title</strong> } @ph.Caption</figcaption>
        </figure>
    }
</div>
<p class="mute empty" hidden>No photos match. <button type="button" class="clearf" data-act="clear"><Icon Name="close" /> Clear filters</button></p>

<Lightbox />

@code {
    // a new order on every request, the HTML is served no-cache so each reload reshuffles
    readonly PhotoList.Photo[] Shuffled = Shuffle(PhotoList.Items);
    static PhotoList.Photo[] Shuffle(PhotoList.Photo[] items) { var a = items.ToArray(); Random.Shared.Shuffle(a); return a; }
    static string TagAttr(PhotoList.Photo p) => Finder.TagAttr(p.Tags);
    static string TextAttr(PhotoList.Photo p) => $"{p.Title} {p.Caption} {p.Alt} {TagAttr(p)}".ToLowerInvariant();
}
